# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Any LangChain provider string works: "openai:...", "anthropic:...", "azure_openai:...", "ollama:..."
# (install the matching langchain-<provider> package for non-OpenAI providers)
MODEL=openai:gpt-5.4-mini
OPENAI_MODEL=gpt-5.4-mini            # Part 1 only (raw OpenAI SDK)
EMBEDDING_MODEL=openai:text-embedding-3-small

# Part 11: your provider's list price in USD per 1M tokens, used for the cost report
PRICE_INPUT_PER_1M=0
PRICE_OUTPUT_PER_1M=0
# PRICE_CACHED_INPUT_PER_1M=0      # cached input price, if your provider has one; unset means full input price

# Optional tracing with LangSmith (Part 11)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=hr-helpdesk-agent
